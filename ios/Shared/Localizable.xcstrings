    "Choose a photo with a QR code instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورة تحتوي على رمز QR بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle stattdessen ein Foto mit einem QR-Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una foto con un código QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez plutôt une photo contenant un code QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに QR コードが写った写真を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 QR 코드가 있는 사진을 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо этого выберите фото с QR-кодом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn một ảnh có mã QR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以改为选择一张带二维码的照片。"
          }
        }
      }
    },
