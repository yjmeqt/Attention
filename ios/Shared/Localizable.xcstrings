    "Saved items are tagged with the list's title.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved items are tagged with the list's title."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توسم العناصر المحفوظة باسم القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicherte Objekte bekommen den Titel der Liste als Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos guardados se etiquetan con el título de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments enregistrés reçoivent le titre de la liste comme tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した項目にはリスト名のタグが付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 항목에는 목록 제목이 태그로 붙습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые элементы получат тег с названием списка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục đã lưu sẽ được gắn thẻ bằng tên danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的条目会以列表标题作为标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的項目會以列表標題作為標籤。"
          }
        }
      }
    },
