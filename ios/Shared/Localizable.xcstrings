    "Get a card with the title, cover and QR code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على بطاقة بالعنوان والغلاف ورمز QR"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Karte mit Titel, Cover und QR-Code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén una tarjeta con el título, la portada y un código QR"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez une carte avec le titre, la couverture et un code QR"
