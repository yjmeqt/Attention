    "Save links from YouTube, X and any other site. No feed, no algorithm, no tracking." : {
      "comment" : "Simplified Chinese keeps its own pitch, sending links to WeChat, which shows them bare; other languages, Traditional Chinese included, pitch one library.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ الروابط من YouTube وX وأي موقع آخر. بلا خلاصة، ولا خوارزمية، ولا تتبع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere Links von YouTube, X und jeder anderen Website. Kein Feed, kein Algorithmus, kein Tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda enlaces de YouTube, X y cualquier otro sitio. Sin feed, sin algoritmo, sin rastreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez des liens de YouTube, X et de n’importe quel site. Pas de fil, pas d’algorithme, pas de suivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube や X など、どのサイトのリンクも保存できます。フィードも、アルゴリズムも、トラッキングもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube, X 등 어떤 사이트의 링크든 저장하세요. 피드도, 알고리즘도, 추적도 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте ссылки с YouTube, X и любых других сайтов. Без ленты, без алгоритмов, без отслеживания."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu liên kết từ YouTube, X và mọi trang khác. Không bảng tin, không thuật toán, không theo dõi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube、X 等很多网站的链接在微信里只显示一串网址。把它们变成带标题、封面和二维码的图片卡片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存 YouTube、X 和任何網站的連結。沒有動態消息、沒有演算法、沒有追蹤。"
          }
        }
      }
    },
