    "The link stops working for everyone. People who already saved its items keep them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The link stops working for everyone. People who already saved its items keep them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "链接对所有人失效。已经保存了其中条目的人会保留它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連結對所有人失效。已經儲存了其中項目的人會保留它們。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクは誰も使えなくなります。すでに項目を保存した人の手元には残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 사람에게 링크가 작동하지 않게 됩니다. 이미 항목을 저장한 사람은 그대로 유지됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link funktioniert dann für niemanden mehr. Wer ihre Objekte schon gesichert hat, behält sie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien cesse de fonctionner pour tout le monde. Les personnes qui ont déjà enregistré ses éléments les conservent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace deja de funcionar para todos. Quienes ya guardaron sus elementos los conservan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылка перестанет работать для всех. Те, кто уже сохранил объекты, их сохранят."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liên kết sẽ ngừng hoạt động với mọi người. Ai đã lưu các mục thì vẫn giữ chúng."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف الرابط عن العمل للجميع. يحتفظ من حفظوا عناصرها بها."
          }
        }
      }
    },
