    "Copy a link, or share it to %@ from any app": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ رابطًا، أو شاركه مع %@ من أي تطبيق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere einen Link oder teile ihn aus jeder App mit %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia un enlace o compártelo con %@ desde cualquier app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez un lien ou partagez-le vers %@ depuis n’importe quelle app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクをコピーするか、どのアプリからでも %@ に共有"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 복사하거나 아무 앱에서나 %@(으)로 공유하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопируйте ссылку или поделитесь ею с %@ из любого приложения"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép liên kết, hoặc chia sẻ đến %@ từ bất kỳ ứng dụng nào"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制链接，或在任意 App 里分享给 %@"
          }
        }
      }
    },
    "Couldn't load a preview, so this is a basic card.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل المعاينة، لذا أُنشئت بطاقة أساسية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Vorschau verfügbar, daher eine einfache Karte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar una vista previa; esta es una tarjeta básica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger un aperçu : voici une carte simple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューを読み込めなかったため、シンプルなカードを作成しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기를 불러올 수 없어 기본 카드로 만들었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить превью, поэтому создана простая карточка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được bản xem trước nên đã tạo thẻ cơ bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取预览，已生成基础卡片。"
          }
        }
      }
