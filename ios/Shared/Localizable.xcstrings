    "The person who shared it revoked it, or it was removed after a report.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The person who shared it revoked it, or it was removed after a report."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألغى من شاركها مشاركتها، أو أزيلت بعد بلاغ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person, die sie geteilt hat, hat sie zurückgezogen, oder sie wurde nach einer Meldung entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien la compartió la retiró, o se eliminó tras una denuncia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La personne qui l'a partagée l'a retirée, ou elle a été supprimée après un signalement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有した人が取り消したか、報告を受けて削除されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유한 사람이 철회했거나 신고 후 삭제되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автор отозвал его, или он удалён после жалобы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người chia sẻ đã thu hồi, hoặc danh sách đã bị gỡ sau khi bị báo cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享者已经撤回，或者它在被举报后已移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享者已經撤回，或者它在被檢舉後已移除。"
          }
        }
      }
    },
    "The link may be incomplete. Check with the person who shared it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link may be incomplete. Check with the person who shared it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون الرابط ناقصًا. تحقق منه مع من شاركه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link ist vielleicht unvollständig. Frag bei der Person nach, die ihn geteilt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que el enlace esté incompleto. Consulta a quien lo compartió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien est peut-être incomplet. Vérifiez auprès de la personne qui l'a partagé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクが不完全かもしれません。共有した人に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 불완전할 수 있습니다. 공유한 사람에게 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, ссылка неполная. Уточните у того, кто ею поделился."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết có thể không đầy đủ. Hãy hỏi lại người đã chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接可能不完整，请向分享者确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結可能不完整，請向分享者確認。"
          }
        }
      }
    },
    "Check your connection and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 상태를 확인하고 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте подключение и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra kết nối rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查網路連線後再試一次。"
          }
        }
      }
    },
