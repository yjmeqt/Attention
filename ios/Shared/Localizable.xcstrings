    "Link preview" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link preview"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "链接预览图"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連結預覽圖"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクのプレビュー"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크 미리보기"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkvorschau"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu du lien"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa del enlace"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превью ссылки"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh xem trước liên kết"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معاينة الرابط"
          }
        }
      }
    },
    "Apps that show link previews show this picture. To send a picture instead, as in WeChat, share the link to Attention and send its card." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps that show link previews show this picture. To send a picture instead, as in WeChat, share the link to Attention and send its card."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会显示链接预览的 App 里，对方看到的就是这张图。想发图片（比如在微信里），把链接分享给 Attention，再发它生成的卡片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會顯示連結預覽的 App 裡，對方看到的就是這張圖。想傳圖片（例如在微信裡），把連結分享給 Attention，再傳它產生的卡片。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクのプレビューを表示する App では、この画像が表示されます。画像で送りたいとき（WeChat など）は、リンクを Attention で共有して、作られたカードを送ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크 미리보기를 보여 주는 앱에서는 이 이미지가 보입니다. 이미지로 보내려면(WeChat 등) 링크를 Attention으로 공유한 다음 만들어진 카드를 보내세요."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps mit Linkvorschau zeigen dieses Bild. Um stattdessen ein Bild zu senden, etwa in WeChat, teile den Link mit Attention und sende die Karte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps qui affichent un aperçu des liens montrent cette image. Pour envoyer une image, comme dans WeChat, partagez le lien avec Attention et envoyez sa carte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps que muestran vistas previas de enlaces muestran esta imagen. Para enviar una imagen, como en WeChat, comparte el enlace con Attention y envía su tarjeta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложения с превью ссылок покажут эту картинку. Чтобы отправить изображение, например в WeChat, поделитесь ссылкой с Attention и отправьте её карточку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các app có hiện ảnh xem trước liên kết sẽ hiện hình này. Muốn gửi hình ảnh (như trong WeChat), hãy chia sẻ liên kết vào Attention rồi gửi thẻ của nó."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض التطبيقات التي تُظهر معاينات الروابط هذه الصورة. لإرسال صورة بدلًا من ذلك، كما في WeChat، شارك الرابط مع Attention وأرسل بطاقته."
          }
        }
      }
    },
    "The list is uploaded to Attention's server, and anyone with the link can see it. Editing these items later doesn't change it. You can take it down from Shared Lists in the sidebar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The list is uploaded to Attention's server, and anyone with the link can see it. Editing these items later doesn't change it. You can take it down from Shared Lists in the sidebar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表会上传到 Attention 的服务器，任何拿到链接的人都能看到。之后修改这些条目，已分享的列表不会变。你可以在侧边栏的“已分享的列表”里撤回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "列表會上傳到 Attention 的伺服器，任何拿到連結的人都能看到。之後修改這些項目，已分享的列表不會變。你可以在側邊欄的「已分享的列表」裡撤回。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストは Attention のサーバにアップロードされ、リンクを知っている人なら誰でも見られます。あとでこれらの項目を編集しても変わりません。サイドバーの「共有したリスト」で取り下げられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록은 Attention 서버에 업로드되며, 링크가 있는 누구나 볼 수 있습니다. 나중에 이 항목들을 편집해도 바뀌지 않습니다. 사이드바의 공유한 목록에서 내릴 수 있습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste wird auf den Server von Attention geladen, und alle mit dem Link können sie sehen. Spätere Änderungen an diesen Objekten ändern sie nicht. Du kannst sie in der Seitenleiste unter „Geteilte Listen“ zurückziehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste est envoyée sur le serveur d’Attention, et toute personne ayant le lien peut la voir. Modifier ces éléments ensuite ne la change pas. Vous pouvez la retirer depuis Listes partagées dans la barre latérale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista se sube al servidor de Attention y cualquiera con el enlace puede verla. Editar estos elementos después no la cambia. Puedes retirarla desde Listas compartidas en la barra lateral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Список загружается на сервер Attention, и его может увидеть любой, у кого есть ссылка. Последующие изменения этих объектов его не меняют. Его можно удалить в разделе «Отправленные списки» на боковой панели."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh sách được tải lên máy chủ của Attention và ai có liên kết đều xem được. Sửa các mục này sau đó không làm thay đổi danh sách. Bạn có thể gỡ nó trong Danh sách đã chia sẻ ở thanh bên."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُرفع القائمة إلى خادم Attention، ويمكن لأي شخص لديه الرابط رؤيتها. لا يغيّرها تعديل هذه العناصر لاحقًا. يمكنك إزالتها من القوائم المشتركة في الشريط الجانبي."
          }
        }
      }
    },
