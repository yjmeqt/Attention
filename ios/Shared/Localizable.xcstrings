    "That QR code doesn't contain a link.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي رمز QR هذا على رابط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR-Code enthält keinen Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código QR no contiene un enlace."
          }
        },
        "fr": {
