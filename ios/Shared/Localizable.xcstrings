    },
    "A list holds up to %lld items; left out: %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A list holds up to %lld items; left out: %lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个列表最多 %lld 条，未包含：%lld 条"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個列表最多 %lld 項，未包含：%lld 項"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストは最大 %lld件まで。含まれない項目：%lld件"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록에는 최대 %lld개까지 들어갑니다. 빠진 항목: %lld개"
          }
        },
        "de" : {
          "stringUnit" : {
