    "Private items are protected by Face ID or your passcode. Turn on a passcode in Settings to use Private." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العناصر الخاصة محمية بـ Face ID أو رمز الدخول. شغّل رمز الدخول في الإعدادات لاستخدام الخاص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private Objekte sind mit Face ID oder deinem Code geschützt. Aktiviere in den Einstellungen einen Code, um „Privat“ zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos privados están protegidos con Face ID o tu código. Activa un código en Ajustes para usar Privado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments privés sont protégés par Face ID ou votre code. Activez un code dans Réglages pour utiliser Privé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライベートの項目は Face ID またはパスコードで保護されます。プライベートを使うには「設定」でパスコードをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비공개 항목은 Face ID 또는 암호로 보호됩니다. 비공개를 사용하려면 설정에서 암호를 켜세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Личные объекты защищены Face ID или код-паролем. Чтобы пользоваться разделом «Личное», включите код-пароль в Настройках."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục riêng tư được bảo vệ bằng Face ID hoặc mật mã. Hãy bật mật mã trong Cài đặt để dùng Riêng tư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私密内容由面容 ID 或设备密码保护。请先在“设置”中开启密码，才能使用私密。"
          }
        }
      }
    },
