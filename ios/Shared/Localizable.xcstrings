    "Send the image anywhere, then paste the link — it's already copied" : {
      "comment" : "Simplified Chinese keeps its own pitch, sending links to WeChat, which shows them bare; other languages, Traditional Chinese included, pitch one library.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل الصورة إلى أي مكان، ثم الصق الرابط — فهو منسوخ بالفعل"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende das Bild, wohin du willst, und füge dann den Link ein – er ist schon kopiert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía la imagen donde quieras y pega el enlace: ya está copiado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez l’image où vous voulez, puis collez le lien — il est déjà copié"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像を好きな場所に送ってからリンクを貼り付け(コピー済み)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지를 원하는 곳에 보낸 뒤 링크를 붙여넣으세요. 이미 복사되어 있습니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправьте изображение куда угодно, затем вставьте ссылку — она уже скопирована"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi ảnh đến bất kỳ đâu, rồi dán liên kết — liên kết đã được sao chép"
