{
  "sourceLanguage": "en",
  "strings": {
    "%@ now shows up front in the share sheet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر %@ الآن في مقدمة ورقة المشاركة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erscheint jetzt vorne im Teilen-Menü"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ahora aparece al principio de la hoja para compartir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ apparaît désormais en tête de la feuille de partage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これで %@ が共有シートの先頭に表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 공유 시트 맨 앞에 %@이(가) 표시됩니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь %@ отображается в начале меню «Поделиться»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ đây %@ sẽ hiện ở đầu bảng chia sẻ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后 %@ 会出现在分享面板最前面"
          }
        }
      }
    },
