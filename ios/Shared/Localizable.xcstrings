            "value": "点击分享按钮"
          }
        }
      }
    },
    "Tap ✓ to finish": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 ✓ 完成"
          }
        }
      }
    },
    "Template": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字"
          }
        }
      }
    },
    "That QR code doesn't contain a link.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个二维码里没有链接。"
          }
        }
      }
    },
    "WeChat": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微信"
          }
        }
      }
    },
    "You copied a link": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你复制了一个链接"
          }
        }
      }
    },
    "YouTube, X and many sites show up in WeChat as a bare link. Turn them into an image card with the title, cover and a QR code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube、X 等很多网站的链接在微信里只显示一串网址。把它们变成带标题、封面和二维码的图片卡片。"
          }
        }
      }
    },
    "Your card will appear here": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片会显示在这里"
          }
        }
      }
    }
  },
  "version": "1.0"
}