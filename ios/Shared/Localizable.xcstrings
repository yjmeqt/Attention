    "Only links and text can be shared as a list. Images and private items stay on your devices." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only links and text can be shared as a list. Images and private items stay on your devices."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有链接和文字可以作为列表分享。图片和私密条目只留在你的设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有連結和文字可以作為列表分享。圖片和私密項目只留在你的裝置上。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストとして共有できるのはリンクとテキストだけです。画像とプライベート項目はデバイスに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크와 텍스트만 목록으로 공유할 수 있습니다. 이미지와 비공개 항목은 기기에만 남습니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Links und Text lassen sich als Liste teilen. Bilder und private Objekte bleiben auf deinen Geräten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les liens et le texte peuvent être partagés en liste. Les images et les éléments privés restent sur vos appareils."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo los enlaces y el texto se pueden compartir como lista. Las imágenes y los elementos privados se quedan en tus dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Списком можно поделиться только ссылками и текстом. Изображения и личные объекты остаются на ваших устройствах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ liên kết và văn bản mới chia sẻ được dưới dạng danh sách. Hình ảnh và mục riêng tư vẫn ở trên thiết bị của bạn."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن مشاركة الروابط والنصوص فقط كقائمة. تبقى الصور والعناصر الخاصة على أجهزتك."
          }
        }
      }
    },
