{
  "sourceLanguage": "en",
  "strings": {
    "%@ now shows up front in the share sheet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后 %@ 会出现在分享面板最前面"
          }
        }
      }
    },
    "AirDrop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隔空投送"
          }
        }
      }
    },
    "Aspect ratio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比例"
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动"
          }
        }
      }
    },
    "Auto · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动 · %@"
          }
        }
      }
    },
    "Camera unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用相机"
          }
        }
      }
    },
    "Card": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片"
          }
        }
      }
    },
    "Choose a photo with a QR code instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以改为选择一张带二维码的照片。"
          }
        }
      }
    },
    "Choose from Photos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从相册选择"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "Copy a link, or share it to %@ from any app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制链接，或在任意 App 里分享给 %@"
          }
        }
      }
    },
    "Couldn't load a preview, so this is a basic card.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取预览，已生成基础卡片。"
          }
        }
      }
    },
