          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 ⌘V 粘贴链接、图片或文本，或拖放到此处。若要制作链接卡片，请复制链接并按 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
