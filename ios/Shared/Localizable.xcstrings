            "value" : "Eine Liste fasst bis zu %lld Objekte; weggelassen: %lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une liste contient au plus %lld éléments ; laissés de côté : %lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lista admite hasta %lld elementos; quedan fuera: %lld"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В списке не больше %lld объектов; не вошло: %lld"
          }
        },
        "vi" : {
          "stringUnit" : {
