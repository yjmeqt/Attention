    "People who open the list and save it get its items tagged with this title." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People who open the list and save it get its items tagged with this title."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开列表并保存的人，会得到带有这个标题标签的条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
