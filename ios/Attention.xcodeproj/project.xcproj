{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "ar",
      "de",
      "es",
      "fr",
      "ja",
      "ko",
      "ru",
      "vi",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "ActionExtension",
      "target-membership": [
        "AttentionAction",
      ],
      "membership-exceptions": [
        {
          "target": "AttentionAction",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "App",
      "target-membership": [
        "Attention",
      ],
      "membership-exceptions": [
        {
          "target": "Attention",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "AttentionMac",
          "inclusions": [
            "Attention.icon",
            "AttentionDev.icon",
            "PrivacyInfo.xcprivacy",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Mac",
      "target-membership": [
        "AttentionMac",
      ],
      "membership-exceptions": [
        {
          "target": "AttentionMac",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Shared",
      "children": [
        {
          "path": "EmptyState.swift",
          "target-membership": [
            "Attention/compile-sources",
            "AttentionExtension/compile-sources",
            "AttentionAction/compile-sources",
