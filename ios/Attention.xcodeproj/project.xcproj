            "AttentionMac/compile-sources",
            "AttentionAction/compile-sources",
          ],
        }, {
          "path": "Platform.swift",
          "target-membership": [
            "Attention/compile-sources",
            "AttentionExtension/compile-sources",
            "AttentionMac/compile-sources",
            "AttentionAction/compile-sources",
          ],
        }, {
          "path": "QRScanner.swift",
          "target-membership": [
            "Attention/compile-sources",
            "AttentionExtension/compile-sources",
            "AttentionAction/compile-sources",
          ],
        }, {
          "path": "ReviewPrompt.swift",
          "target-membership": [
            "Attention/compile-sources",
            "AttentionExtension/compile-sources",
            "AttentionAction/compile-sources",
          ],
        }, {
          "path": "CopyGuide.swift",
          "target-membership": [
            "Attention/compile-sources",
            "AttentionExtension/compile-sources",
            "AttentionAction/compile-sources",
          ],
        }, {
          "path": "ShareSuggestions.swift",
          "target-membership": [
            "Attention/compile-sources",
            "AttentionExtension/compile-sources",
            "AttentionAction/compile-sources",
          ],
        }, {
          "path": "Sharing.swift",
          "target-membership": [
            "Attention/compile-sources",
            "AttentionExtension/compile-sources",
            "AttentionAction/compile-sources",
          ],
        }, {
          "path": "Unfurler.swift",
          "target-membership": [
            "Attention/compile-sources",
            "AttentionExtension/compile-sources",
            "AttentionMac/compile-sources",
            "AttentionAction/compile-sources",
          ],
        },
        { "kind": "folder", "path": "Card", "target-membership": [ "Attention", "AttentionExtension", "AttentionMac", "AttentionAction" ] },
        {
          "kind": "folder",
          "path": "Features",
          "target-membership": [
            "Attention",
            "AttentionExtension",
            "AttentionAction",
          ],
          "membership-exceptions": [
            {
              "target": "AttentionMac",
              "inclusions": [
